# Example environment file for docker-compose.
# Copy to `.env` at the repo root and fill in real values.
# docker-compose auto-loads a root `.env` and interpolates ${VAR} references.
# Do NOT commit the real `.env` (it is git-ignored).

# ─── App ──────────────────────────────────────────────────────────────────────
# For production set NODE_ENV=production (engages Secure/SameSite cookies) and
# CLIENT_ORIGIN to the real site origin (must match the frontend URL exactly for CORS).
NODE_ENV=development
PORT=9012
CLIENT_ORIGIN=http://localhost:3000

# ─── Frontend build (CRA inlines this at BUILD time via docker build arg) ─────
# The URL the browser calls for the API, e.g. https://telugusambandham.com/api
REACT_APP_API_BASE_URL=https://telugusambandham.com/api

# ─── JWT secrets (use long random strings) ────────────────────────────────────
TOKEN_SECRET=replace_with_strong_random_string
REFRESH_TOKEN_SECRET=replace_with_strong_random_string
ADMIN_TOKEN_SECRET=replace_with_strong_random_string

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_USER=telugusambandham@gmail.com
EMAIL_PASS=
EMAIL_FROM=TeluguSambandham <telugusambandham@gmail.com>

# ─── Postgres ─────────────────────────────────────────────────────────────────
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres
