# ═══════════════════════════════════════════════════════════════════════════
# Backend (Node / Express) — TEMPLATE
#
# Copy to `backend/.env` and fill in real values. Never commit the real .env.
# Restart the server after editing it.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development          # production enables Secure/SameSite cookies
PORT=9012
# Must match the frontend origin exactly (CORS). Production: https://your-site.com
CLIENT_ORIGIN=http://localhost:3000

# ── JWT secrets (use long random strings, different for each) ──────────────
TOKEN_SECRET=replace_with_strong_random_string
REFRESH_TOKEN_SECRET=replace_with_strong_random_string
ADMIN_TOKEN_SECRET=replace_with_strong_random_string

# ── PostgreSQL ─────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_with_db_password
PGDATABASE=postgres

# ── Email (SMTP via Gmail app password) — needed for OTP emails ────────────
EMAIL_USER=your_address@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=TeluguSambandham <your_address@gmail.com>
